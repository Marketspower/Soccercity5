// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  email         String    @unique
  phone         String?
  role          String    @default("client")
  createdAt     DateTime  @default(now()) @map("created_at")
  
  reservations  Reservation[]
  notifications Notification[] @relation("NotificationSender")
  ratings       Rating[]
  reviews       Review[]

  @@map("users")
}

model Reservation {
  id            String   @id @default(cuid())
  userId        String?  @map("user_id")
  userName      String   @map("user_name")
  userEmail     String   @map("user_email")
  userPhone     String   @map("user_phone")
  date          String
  hour          Int
  price         Float
  status        String   @default("confirmed")
  createdAt     DateTime @default(now()) @map("created_at")
  
  user          User?    @relation(fields: [userId], references: [id])

  @@unique([date, hour])
  @@map("reservations")
}

model PrivateEvent {
  id          String   @id @default(cuid())
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  company     String?
  phone       String
  email       String
  date        String
  guests      Int
  type        String
  message     String
  status      String   @default("new")
  createdAt   DateTime @default(now()) @map("created_at")
  
  // Relations avec les médias
  media       Media[]
  gallery     Gallery[]

  @@map("private_events")
}

model Availability {
  id          String   @id @default(cuid())
  date        String
  hour        Int
  blocked     Boolean  @default(true)
  reason      String?

  @@unique([date, hour])
  @@map("availability")
}

model Review {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")
  author      String
  role        String?
  rating      Int
  text        String
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  
  user        User?    @relation(fields: [userId], references: [id])

  @@map("reviews")
}

// ============================================
// GALLERY - Pour les images
// ============================================
model Gallery {
  id          String   @id @default(cuid())
  imageUrl    String   @map("image_url")
  alt         String
  sortOrder   Int      @default(0) @map("sort_order")
  eventId     String?  @map("event_id")
  createdAt   DateTime @default(now()) @map("created_at")
  
  event       PrivateEvent? @relation(fields: [eventId], references: [id])

  @@map("gallery")
}

// ============================================
// MEDIA - Pour les vidéos et autres médias
// ============================================
model Media {
  id          String   @id @default(cuid())
  title       String
  url         String
  type        String   // 'video', 'photo', 'audio'
  thumbnail   String?  // URL de la vignette
  duration    String?  // Durée de la vidéo
  description String?
  isFeatured  Boolean  @default(false)
  eventId     String?  @map("event_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  event       PrivateEvent? @relation(fields: [eventId], references: [id])

  @@map("media")
}

model Setting {
  key         String   @id
  value       Json
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@map("settings")
}

model Notification {
  id          String   @id @default(cuid())
  title       String
  body        String
  audience    String   @default("all")
  sentById    String?  @map("sent_by") 
  sentAt      DateTime @default(now()) @map("sent_at")
  
  sentBy      User?    @relation("NotificationSender", fields: [sentById], references: [id])

  @@map("notifications")
}

model Stats {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Int      @default(0)
  label       String
  suffix      String   @default("")
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@map("stats")
}

model Rating {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")
  rating      Int
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at")
  
  user        User?    @relation(fields: [userId], references: [id])

  @@map("ratings")
}

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@map("pages")
}