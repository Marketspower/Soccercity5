{
  "version": 2,
  "builds": [
    {
      "src": "Frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "Frontend/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/event-requests",
      "schedule": "0 12 * * *"
    }
  ]
}
